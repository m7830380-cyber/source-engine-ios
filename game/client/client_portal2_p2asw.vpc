//-----------------------------------------------------------------------------
//	CLIENT_PORTAL2_P2ASW.VPC
//
//	P2ASW (EpicSentry/P2ASW) Portal 2 game code on the CS:GO engine, on top of the RubberWar port (client_portal_base +
//	the mod's Portal 2 / GameUI sources). See https://github.com/RubberWar/Portal-2
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 			"portal2"

$Include "$SRCDIR\game\client\client_portal_base.vpc"

$Project
{
	-$File "vgui_fpspanel.cpp"
	$File "$SRCDIR\public\XUnzip.cpp"
	$File "portal2\portal2_ios_link_stubs.cpp"
	$File "portal2\portal2_ios_client_convars.cpp"
	$File "portal2\portal2_options_multiplayer_stub.cpp"
	$File "portal2\portal2_ios_vgui_link_stubs.cpp"
	$File "portal2\portal2_liquidportal_client_stub.cpp"
	$File "portal2\portal2_gameui_ios_stubs.cpp"
	$File "portal2\portal2_achievements_client_stub.cpp"
	$File "portal2\portal2_ios_dt_stubs.cpp"
	// Restore real portal mesh/stencil (was stubbed for early link bring-up).
	// Keep radial/liquid stubs — those are UI polish, not SP portal views.
	-$File "c_mod_lesson_stubs.cpp"
	-$File "hl2\vgui_rootpanel_hl2.cpp"
	-$File "hl2\hl_prediction.cpp"
	-$File "hl2\hl_in_main.cpp"
	// portal_gamemovement.cpp comes from client_portal_base.vpc — do not exclude.
	-$File "portal\portal_credits.cpp"
	$File "$SRCDIR\common\imageutils.cpp"
	$File "$SRCDIR\common\imageutils.h"
	$File "$SRCDIR\game\shared\bannedwords.cpp"
	$File "$SRCDIR\game\shared\bannedwords.h"
	$File "portal2\portal2_hltv_replay_client_stub.cpp"
	$File "$SRCDIR\common\platforminputdevice.cpp"
	$File "$SRCDIR\common\platforminputdevice.h"
	$File "steamworks_gamestats_client.cpp"
	$File "steamworks_gamestats_client.h"
}

// iOS: CS:GO engine protobuf user messages; Portal 2 legacy messages as protobufs.
$include "$SRCDIR\game\shared\cstrike15\cstrike15_gcmessages_include.vpc" [$IOS]
$include "$SRCDIR\game\shared\cstrike15\cstrike15_usermessages_include.vpc" [$IOS]
$include "$SRCDIR\game\shared\base_gcmessages_include.vpc" [$IOS]

$Project
{
	$Folder "Protobuf Files" [$IOS]
	{
		$File "$SRCDIR\gcsdk\steammessages.proto"
		$File "$SRCDIR\game\shared\portal2\portal2_usermessages.proto"
		$DynamicFile "$GENERATED_PROTO_DIR\portal2_usermessages.pb.cc"
		$DynamicFile "$GENERATED_PROTO_DIR\steammessages.pb.cc"
		$File "$SRCDIR\game\shared\portal2\legacy_usermessages.cpp"
		-$File "c_te_playerdecal.cpp"
		$File "portal2\c_te_playerdecal_portal2.cpp"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\hl2\elements;$SRCDIR\game\client\portal2;$SRCDIR\game\client\portal2\gameui;$SRCDIR\game\client\portal2\gameui\portal2;$SRCDIR\game\shared\portal2;.\hl2;.\portal;.\portal\vgui;.\portal2;.\portal2\vgui;.\portal2\gameui\portal2;.\vgui;$SRCDIR\game\shared\portal;$SRCDIR\game\shared\multiplayer;$SRCDIR\game\shared\hl2"
		$PreprocessorDefinitions		"$BASE;PORTAL;PORTAL2;GAMEUI_EMBEDDED;GAMEUI_EXPORTS"
		$PreprocessorDefinitions		"$BASE;NO_STEAM_GAMECOORDINATOR"					[ $IOS ]
	}
}

$Project "Client (Portal 2)"
{
	$Folder	"Source Files"
	{
		$File	"$SRCDIR\common\language.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}

		$Folder	"HL2 DLL"
		{
			$File	"death.cpp"
			$File	"hl2\c_te_concussiveexplosion.cpp"
			$File	"hl2\c_te_flare.cpp"
		}

		$Folder	"Portal (RubberWar)"
		{
			$File	"$SRCDIR\game\shared\portal\portal_gamerules.cpp"
			$File	"$SRCDIR\game\shared\portal\portal_gamerules.h"
		}

