//-----------------------------------------------------------------------------
//	CLIENT_PORTAL2_RUBBERWAR.VPC
//
//	RubberWar/Portal-2 game code on the CS:GO engine (client_portal_base +
//	the mod's Portal 2 / GameUI sources). See https://github.com/RubberWar/Portal-2
//-----------------------------------------------------------------------------

$Macro GAMENAME 			"portal2"

$Include "client_portal_base.vpc"

// iOS: CS:GO engine protobuf user messages; Portal 2 legacy messages as protobufs.
$include "$SRCDIR\game\shared\cstrike15\cstrike15_gcmessages_include.vpc" [$IOS]
$include "$SRCDIR\game\shared\cstrike15\cstrike15_usermessages_include.vpc" [$IOS]

$Project
{
	$Folder "Protobuf Files" [$IOS]
	{
		$File "$SRCDIR\gcsdk\steammessages.proto"
		$File "$SRCDIR\game\shared\portal2\portal2_usermessages.proto"
		$DynamicFile "$GENERATED_PROTO_DIR\portal2_usermessages.pb.cc"
		$File "$SRCDIR\game\shared\portal2\legacy_usermessages.cpp"
		-$File "c_te_playerdecal.cpp"
		$File "portal2\c_te_playerdecal_portal2.cpp"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\client\portal2\gameui;$SRCDIR\game\shared\portal2"
		$PreprocessorDefinitions		"$BASE;PORTAL2;GAMEUI_EMBEDDED;GAMEUI_EXPORTS"
		$PreprocessorDefinitions		"$BASE;NO_STEAM_GAMECOORDINATOR"					[ $IOS ]
	}
}

$Project "Client (Portal 2)"
{
	$Folder	"Source Files"
	{
		$File	"$SRCDIR\common\language.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}

		$Folder	"Multiplayer"
		{
			$File	"multiplayer\basenetworkedplayer_cl.cpp"
			$File	"multiplayer\basenetworkedragdoll_cl.cpp"
			$File	"$SRCDIR\game\shared\multiplayer\basenetworkedplayer_gamemove.cpp"
			$File	"$SRCDIR\game\shared\multiplayer\basenetworkedplayer_shared.cpp"
			$File	"$SRCDIR\game\shared\multiplayer\multiplayer_animstate.cpp"
		}

		$Folder "Portal 2"
		{
			$File	"portal2\c_portal2_lesson.cpp"
			$File	"portal2\c_sdk_jukebox.cpp"
			$File	"portal2\c_portal_playerlocaldata.cpp"
			$File	"portal2\portal2_input.cpp"
			$File	"portal2\portal2_prediction.cpp"
			$File	"portal2\vgui_rootpanel_portal2.cpp"
			$File	"$SRCDIR\game\shared\predicted_viewmodel.cpp"

			$Folder	"VGUI"
			{
				$File	"portal2\vgui\nb_button.cpp"
				$File	"portal2\vgui\nb_header_footer.cpp"
				$File	"portal2\vgui\nb_horiz_list.cpp"
				$File	"portal2\vgui\nb_select_level_entry.cpp"
				$File	"portal2\vgui\nb_select_level_panel.cpp"
				$File	"portal2\vgui\sdk_hud_ammo.cpp"
				$File	"portal2\vgui\sdk_hud_chat.cpp"
				$File	"portal2\vgui\sdk_hud_health.cpp"
				$File	"portal2\vgui\sdk_hud_weaponselection.cpp"
				$File	"portal2\vgui\sdk_loading_panel.cpp"
				$File	"portal2\vgui\sdk_logo_panel.cpp"
				$File	"portal2\vgui\sdk_vgui_music_importer.cpp"
