		$File	"$SRCDIR\game\shared\portal2\trigger_catapult_shared.cpp"
	}
}

$Project
{
	$Folder	"Link Libraries"
	{
		$Lib			"meshutils"	// HullFromPlanes / CMesh (portal player brush contacts)
	}
}

$Project
{
	$Folder	"Source Files"
	{
		// CS:GO's steamworks_gamestats.cpp already has these key-value helpers
		-$File	"$SRCDIR\game\shared\portal\portal_gamestats_shared.cpp"
	}
}
