//-----------------------------------------------------------------------------
//	SERVER_PORTAL2_RUBBERWAR.VPC — RubberWar/Portal-2 server on the CS:GO engine
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"portal2"
$Macro SRVSRCDIR	"."

$Include "$SRCDIR\game\server\server_portal_base.vpc"

$Project
{
	-$File "$SRCDIR\game\server\vote_controller.cpp"
	$File	"vote_controller_portal2_stub.cpp"
	$File	"portal2\portal2_server_link_stubs.cpp"
	$File	"portal2\portal2_server_gameinterface_stub.cpp"
	$File	"portal2\portal2_cmisile_server_stub.cpp"
	$File	"portal2\portal2_achievements_server_stub.cpp"
	$File "$SRCDIR\common\platforminputdevice.cpp"
	$File "$SRCDIR\common\platforminputdevice.h"
	$File "$SRCDIR\public\XUnzip.cpp"
	-$File "portal\portal_base2d.cpp"
	-$File "portal\portal_base2d.h"
	-$File "hl2\func_tank.cpp"
	-$File "hl2\func_tank.h"
	$File "portal\portal_base2d.cpp"
	$File "portal\portal_client.cpp"
	$File "portal\portal_placement.cpp"
}

$include "$SRCDIR\game\shared\cstrike15\cstrike15_gcmessages_include.vpc" [$IOS]
$include "$SRCDIR\game\shared\cstrike15\cstrike15_usermessages_include.vpc" [$IOS]
$include "$SRCDIR\game\shared\base_gcmessages_include.vpc" [$IOS]

$Project
{
	$Folder "Protobuf Files" [$IOS]
	{
		$File "$SRCDIR\gcsdk\steammessages.proto"
		$File "$SRCDIR\game\shared\portal2\portal2_usermessages.proto"
		$DynamicFile "$GENERATED_PROTO_DIR\portal2_usermessages.pb.cc"
		$DynamicFile "$GENERATED_PROTO_DIR\steammessages.pb.cc"
		$File "$SRCDIR\game\shared\portal2\legacy_usermessages.cpp"
		-$File "$SRVSRCDIR\te_playerdecal.cpp"
		$File "portal2\te_playerdecal_portal2.cpp"
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\portal;$SRCDIR\game\shared\portal2;.\hl2;.\episodic;$SRCDIR\game\shared\multiplayer;$SRCDIR\game\shared\hl2;.\portal;.\portal2;$SRCDIR\game\shared\cstrike15"
		$PreprocessorDefinitions		"$BASE;PORTAL2;PORTAL;USES_SAVERESTORE"
		$PreprocessorDefinitions		"$BASE;NO_STEAM_GAMECOORDINATOR"					[ $IOS ]
	}
}

$Project "Server (Portal 2)"
{
	$Folder	"Source Files"
	{
		$Folder	"Portal (RubberWar)"
		{
			$File	"$SRCDIR\game\shared\portal\portal_gamerules.cpp"
			$File	"$SRCDIR\game\shared\portal\portal_gamerules.h"
			$File	"$SRCDIR\game\shared\portal2\player_pickup.cpp"
			$File	"$SRCDIR\game\shared\portal2\player_pickup.h"
			$File	"portal2\portal2_cs_grenade_server_stub.cpp"
		}

		$Folder	"Multiplayer"
		{
			$File	"multiplayer\basenetworkedplayer.cpp"
			$File	"multiplayer\basenetworkedragdoll.cpp"
			$File	"$SRCDIR\game\shared\multiplayer\basenetworkedplayer_gamemove.cpp"
			$File	"$SRCDIR\game\shared\multiplayer\basenetworkedplayer_shared.cpp"
		}

		$Folder	"Portal 2"
		{
			$File	"portal2\npc_personality_core.cpp"
			$File	"portal2\npc_wheatley_boss.cpp"
			-$File	"portal2\player_pickup_controller.cpp"
			-$File	"portal2\player_pickup_controller.h"
			$File	"portal2\prop_button.cpp"
			$File	"portal2\prop_button_base.cpp"
			$File	"portal2\prop_button_base.h"
			$File	"portal2\prop_floor_button.cpp"
			$File	"portal2\prop_floor_button_base.cpp"
			$File	"portal2\prop_floor_button_base.h"
			$File	"portal2\prop_floor_button_under.cpp"
			$File	"portal2\prop_testchamber_door.cpp"
			$File	"portal2\prop_under_button.cpp"
			$File	"portal2\prop_weighted_cube.cpp"
			$File	"portal2\portal2_eventlog.cpp"
			$File	"portal2\portal2_gamemove.cpp"
			$File	"portal2\portal_playerlocaldata.cpp"
			-$File	"portal2\prop_linked_portal_door.cpp"
			$File	"portal2\func_portalled.cpp"
			$File	"portal2\func_portalled.h"
			$File	"portal2\te_playerdecal_portal2.cpp"
			$File	"$SRCDIR\game\shared\predicted_viewmodel.cpp"
		}
	}
}
