#include "common_ps_fxc.h"

sampler TexSampler	: register( s0 );

struct PS_INPUT
{
	float2 coordTap0				: TEXCOORD0;
	float2 coordTap1				: TEXCOORD1;
	float2 coordTap2				: TEXCOORD2;
	float2 coordTap3				: TEXCOORD3;
};

float4 main( PS_INPUT i ) : COLOR
{
	float4 s0, s1, s2, s3;

	// Sample 4 taps
	s0 = tex2D( TexSampler, i.coordTap0 );
	s1 = tex2D( TexSampler, i.coordTap1 );
	s2 = tex2D( TexSampler, i.coordTap2 );
	s3 = tex2D( TexSampler, i.coordTap3 );

	float4 vResult = ( s0 + s1 + s2 + s3 ) * 0.25f;
	// Force alpha to 1.0: the original luminance write caused ANGLE/Metal to
	// composite intermediate render targets against white when sampling them,
	// producing a white tint around the IronSight scope.
	vResult.a = 1.0f;

	return vResult;
}
